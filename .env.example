# Gedr - Environment Variables
# Copy this file to .env and fill in your values.

# === Required ===
SECRET_KEY=                    # 64-byte random hex - generate with: python -c "import secrets; print(secrets.token_hex(64))"

# === Database ===
DATABASE_URL=                  # Reserved (PostgreSQL upgrade path). The app currently
                               # always uses SQLite regardless of this value.
CCI_DB_PATH=                   # Optional: relocate the SQLite file (default: ./cybercode.db)

# === AI Provider (3-tier fallback chain) ===
# Tier 1: Gedr Fast (primary)
CCI_AI_PROVIDER=               # native (default) or openai
CCI_AI_API_KEY=                # your-key-here
CCI_AI_BASE_URL=               # base URL for openai provider
CCI_AI_MODEL=                  # model id

# Optional sidecar: route AI calls to the ai_service microservice
# (run.py sets the legacy alias CCI_AI_URL; both are honored)
CCI_AI_MICROSERVICE_URL=       # e.g. http://127.0.0.1:8002

# Tier 2: Gedr Cloud fallback (OpenAI-compatible endpoint)
AI_FALLBACK_KEY=               # your-key-here
AI_FALLBACK_URL=               # https://your-openai-compatible-endpoint/v1
AI_FALLBACK_MODEL=             # model id

# Tier 3: Gedr Deep Reasoning fallback
AI_REASONING_KEY=              # your-key-here
AI_REASONING_URL=              # endpoint (defaults to AI_FALLBACK_URL when empty)
AI_REASONING_MODEL=            # model id

# === Security ===
CCI_ALLOWED_SCAN_ROOTS=        # Comma-separated allowed scan paths (empty = unrestricted)
CCI_PUBLIC_SCAN_MODE=false     # true = allow anonymous scan access (DEVELOPMENT ONLY;
                               # the SPA has a login form, leave false in production)

# === Authentication ===
REGISTER_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# === Trust Proxy (set true ONLY behind a trusted reverse proxy) ===
CCI_TRUST_PROXY=false          # If true, X-Forwarded-For from client is trusted for rate limiting

# === OpenVAS (Greenbone) ===
OPENVAS_HOST=localhost
OPENVAS_PORT=9390
OPENVAS_USERNAME=
OPENVAS_PASSWORD=

# === Nessus ===
NESSUS_URL=
NESSUS_API_KEY=
NESSUS_SECRET_KEY=

# === Custom Scanner ===
CCI_CUSTOM_SCANNER_CMD=
CCI_CUSTOM_SCANNER_FORMAT=text

# === Frontend ===
CCI_FRONTEND_DIR=frontend

# === Server ===
CCI_BACKEND_PORT=8000          # Backend port (main.py / run.py)
CCI_WORKER_THREADS=4           # Scan/AI worker thread pool size
CCI_CORS_ORIGINS=              # Semicolon-separated origins (default: http://127.0.0.1:8000;http://localhost:8000)
CCI_LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR
CCI_SSL_KEYFILE=               # TLS keyfile (pair with CCI_SSL_CERTFILE)
CCI_SSL_CERTFILE=              # TLS certfile