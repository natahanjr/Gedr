# Dockerfile for the FastAPI Backend
# Python 3.12 required: backend/scanner_manager.py uses Path.walk() (added in 3.12)
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir psycopg2-binary

# Copy application code (respecting .dockerignore)
COPY . .

# Create non-root user
RUN groupadd -r gedr && useradd -r -g gedr -d /app -s /sbin/nologin gedr \
    && chown -R gedr:gedr /app
USER gedr

# Expose FastAPI port
EXPOSE 8000

# Start the application (backend.api exposes the FastAPI `app`;
# main.py is the local dev launcher and defines no `app` object)
CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000"]
